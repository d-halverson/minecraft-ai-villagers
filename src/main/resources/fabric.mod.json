{
  "schemaVersion": 1,
  "id": "aivillagers",
  "version": "${version}",
  "name": "AI Villagers",
  "description": "Say a named villager's name in chat and it answers in a speech bubble, using a small local LLM (Ollama). Server-side only: vanilla clients can join.",
  "authors": ["Drew Halverson"],
  "contact": {
    "sources": "https://github.com/d-halverson/minecraft-ai-villagers",
    "issues": "https://github.com/d-halverson/minecraft-ai-villagers/issues"
  },
  "license": "MIT",
  "environment": "*",
  "accessWidener": "aivillagers.accesswidener",
  "entrypoints": {
    "main": ["com.drew.aivillagers.AiVillagers"]
  },
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
